# Managed by Ansible — do not edit on server
SECRET_KEY={{ app_secrets.SECRET_KEY }}
DEBUG={{ app_secrets.DEBUG | default('False') }}
ALLOWED_HOSTS={{ app_secrets.ALLOWED_HOSTS | default(domain_frontend ~ ',' ~ domain_backend ~ ',localhost') }}

# Database (RDS)
DB_NAME={{ app_secrets.DB_NAME | default('tricloud_vault') }}
DB_USER={{ app_secrets.DB_USER | default('tricloud_vault') }}
DB_PASSWORD={{ app_secrets.DB_PASSWORD }}
DB_HOST={{ app_secrets.DB_HOST }}
DB_PORT={{ app_secrets.DB_PORT | default('5432') }}

# AWS S3
AWS_ACCESS_KEY_ID={{ app_secrets.AWS_ACCESS_KEY_ID }}
AWS_SECRET_ACCESS_KEY={{ app_secrets.AWS_SECRET_ACCESS_KEY }}
AWS_S3_BUCKET_NAME={{ app_secrets.AWS_STORAGE_BUCKET_NAME }}
AWS_REGION={{ app_secrets.AWS_S3_REGION_NAME | default('ap-south-1') }}

# Azure Blob Storage (file storage)
AZURE_STORAGE_ACCOUNT_NAME={{ app_secrets.AZURE_ACCOUNT_NAME }}
AZURE_STORAGE_ACCOUNT_KEY={{ app_secrets.AZURE_ACCOUNT_KEY }}
AZURE_CONTAINER_NAME={{ app_secrets.AZURE_CONTAINER }}

# GCP
GCP_BUCKET_NAME={{ app_secrets.GCS_BUCKET_NAME }}
GOOGLE_APPLICATION_CREDENTIALS=/home/ubuntu/tricloud-vault/tri_cloud_vault_gcp.json

# Email (SMTP)
EMAIL_HOST_USER={{ app_secrets.EMAIL_HOST_USER }}
EMAIL_HOST_PASSWORD={{ app_secrets.EMAIL_HOST_PASSWORD }}

# Razorpay
RAZORPAY_KEY_ID={{ app_secrets.RAZORPAY_KEY_ID }}
RAZORPAY_KEY_SECRET={{ app_secrets.RAZORPAY_KEY_SECRET }}
RAZORPAY_WEBHOOK_SECRET={{ app_secrets.RAZORPAY_WEBHOOK_SECRET }}

# Redis & Celery (Intent Orchestration FSM)
REDIS_URL={{ app_secrets.REDIS_URL | default('redis://127.0.0.1:6379/0') }}
CELERY_BROKER_URL={{ app_secrets.CELERY_BROKER_URL | default(app_secrets.REDIS_URL | default('redis://127.0.0.1:6379/0')) }}
CELERY_RESULT_BACKEND={{ app_secrets.CELERY_RESULT_BACKEND | default(app_secrets.REDIS_URL | default('redis://127.0.0.1:6379/0')) }}

# -------------------------------------------------------
# LLM Intent Parsing
# Priority 1: AWS Bedrock (Claude) — uses EC2 instance role, no key needed
# Priority 2: Azure OpenAI (GPT-4o) — uses Azure credits
# Priority 3: Heuristic fallback — offline, free
# -------------------------------------------------------
DEFAULT_LLM_PROVIDER={{ app_secrets.DEFAULT_LLM_PROVIDER | default('bedrock') }}

# AWS Bedrock — Claude 3.5 Sonnet (billed to AWS account via IAM instance role)
AWS_BEDROCK_REGION={{ app_secrets.AWS_BEDROCK_REGION | default('ap-south-1') }}
AWS_BEDROCK_MODEL_ID={{ app_secrets.AWS_BEDROCK_MODEL_ID | default('anthropic.claude-3-5-sonnet-20241022-v2:0') }}

# Azure OpenAI — GPT-4o (billed to Azure subscription)
AZURE_OPENAI_ENDPOINT={{ app_secrets.AZURE_OPENAI_ENDPOINT | default('') }}
AZURE_OPENAI_API_KEY={{ app_secrets.AZURE_OPENAI_API_KEY | default('') }}
AZURE_OPENAI_DEPLOYMENT_NAME={{ app_secrets.AZURE_OPENAI_DEPLOYMENT_NAME | default('gpt-4o') }}
AZURE_OPENAI_API_VERSION={{ app_secrets.AZURE_OPENAI_API_VERSION | default('2024-08-01-preview') }}

# Legacy direct API keys (only for local dev, not used in production)
ANTHROPIC_API_KEY={{ app_secrets.ANTHROPIC_API_KEY | default('') }}
OPENAI_API_KEY={{ app_secrets.OPENAI_API_KEY | default('') }}
